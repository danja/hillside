{
  "name": "hillside-media-visualizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && mkdir -p dist/lib && cp src/lib/*.js dist/lib/",
    "build:render": "vite build --config vite.render.config.js && mkdir -p dist-render/lib && cp src/lib/*.js dist-render/lib/",
    "render:videos": "npm run build:render && node scripts/render-videos.js",
    "render:videos:xvfb": "npm run build:render && node scripts/render-videos.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@vitest/ui": "^2.0.5",
    "jsdom": "^26.1.0",
    "puppeteer": "^25.1.0",
    "vite": "^5.4.1",
    "vitest": "^2.0.5"
  }
}
